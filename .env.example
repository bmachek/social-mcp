# --- Required ---------------------------------------------------------------

# Long-lived User access token (ideally 60d) for a Facebook user who:
#   - is an admin of the Facebook Page,
#   - and that Page is linked to the Instagram Professional account you want
#     to post to.
# Recommended: convert a short-lived token via the oauth/access_token endpoint
# (see README) so you get a ~60-day token, then refresh before it expires.
META_ACCESS_TOKEN=

# Instagram Professional account id (a numeric IGSID, not your @handle).
# Discover via: GET /me/accounts?fields=instagram_business_account
IG_USER_ID=

# Facebook Page id (numeric). Discover via: GET /me/accounts
FB_PAGE_ID=

# --- Optional (strongly recommended) ----------------------------------------

# Meta App credentials. Used to build an app access token for /debug_token
# introspection (more reliable than self-introspecting a user token).
META_APP_ID=
META_APP_SECRET=

# --- Optional tunables ------------------------------------------------------

# Graph API version. v25.0 was the latest stable at the time of writing
# (released 2026-02-18). Bump when Meta promotes a newer version.
GRAPH_API_VERSION=v25.0

# How long to wait for an Instagram media container to reach FINISHED before
# giving up, and how often to poll while waiting (seconds).
IG_CONTAINER_TIMEOUT_SECONDS=90
IG_CONTAINER_POLL_SECONDS=3

# Python logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Local-folder posting flow ---------------------------------------------

# Where the bind-mounted data tree lives *inside the container*. Compose maps
# host `./data` -> container `/data`; leave this as /data unless you change
# the volume mapping in docker-compose.yml.
DATA_DIR=/data

# Public HTTPS base URL where Meta can fetch images. Caddy (or whatever your
# reverse proxy is) MUST terminate TLS here and proxy plain HTTP to the
# nginx sidecar on 127.0.0.1:${FILE_SERVER_PORT}. The MCP server appends
# `/<token>/<filename>` to this base when staging a post.
PUBLIC_BASE_URL=https://social.example.com

# Port the nginx sidecar binds to (on 0.0.0.0 so a remote Caddy can reach it
# over Tailscale/Headscale). Reverse-proxy your subdomain to <this-host>:<port>.
FILE_SERVER_PORT=3223

# --- Facebook Group cross-posting -------------------------------------------

# Default Facebook Group ids (comma-separated, numeric). When you call
# post_facebook_local_photo without a group_ids argument, the Page post is
# mirrored to each of these groups. Pass group_ids=[] to skip groups for a
# single call, or group_ids=["123","456"] to override per call.
#
# Requirements (all three needed or every group call returns code 200):
#   - META_ACCESS_TOKEN belongs to a user who is an admin of each group
#   - the Meta App has publish_to_groups granted via App Review
#   - the group allows API posting (some groups disable this)
FB_GROUP_IDS=

# --- Stories ----------------------------------------------------------------

# Stories are posted automatically alongside every feed post by default
# (both IG and FB). Pass also_story=false on the tool call to opt out per
# post. There is no env knob to disable globally — flip it at call time.
# FB Page stories additionally need the pages_manage_posts scope on the token.

# --- Scheduler --------------------------------------------------------------

# Path to the SQLite jobstore. Lives under DATA_DIR by default so it persists
# across container restarts via the bind mount. Override only if you want it
# on a different volume.
SCHEDULER_DB=/data/scheduler/scheduled.db

# --- MCP transport ---------------------------------------------------------

# How MCP clients talk to this server:
#   stdio            - per-call container, JSON-RPC over stdin/stdout (local only)
#   streamable-http  - HTTP server at http://<host>:<port>/mcp (default; LAN/remote)
#   sse              - HTTP server at http://<host>:<port>/sse (legacy)
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=3224
